# ── GenLayer ──────────────────────────────────────────────────────────────────
# RPC endpoint (use https://studio.genlayer.com/api for studionet)
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Chain name: localnet | studionet | testnetAsimov | testnetBradbury
GENLAYER_CHAIN=studionet

# Deployed CredLayer contract address
GENLAYER_CONTRACT_ADDRESS=0x182ed5bB0615AbAC2c351e089C9cc280d72cd888

# Wallet address that deployed the contract (owner of owner-only functions)
GENLAYER_OWNER_ADDRESS=0xE3A26A71b2B26aC623A1F1447D28afc6cac0Fb9c

# Public-side mirror of the owner address (used to gate the /cdl-adm admin UI)
NEXT_PUBLIC_OWNER_ADDRESS=0xE3A26A71b2B26aC623A1F1447D28afc6cac0Fb9c

# Owner's private key — REQUIRED to sign admin-only transactions
# (create_pool, activate_loan, mark_default, close_pool, withdraw_protocol_fees)
# Leave empty if you only deployed the contract; admin actions will be disabled.
GENLAYER_OWNER_PRIVATE_KEY=

# Server-side private key used as HMAC master secret for per-user key derivation
# Generate with: node -e "const {generatePrivateKey}=require('genlayer-js'); console.log(generatePrivateKey())"
GENLAYER_PRIVATE_KEY=0x_your_private_key_here

# ── Supabase ──────────────────────────────────────────────────────────────────
# From your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
